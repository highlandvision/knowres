<?xml version="1.0" encoding="UTF-8"?>
<project name="Know Reservations" basedir="." default="create.package">
	<property name="itsVersion" value="6.0.0"/>
	<property name="itsShortID" value="knowres"/>
	<property name="releases" value="Z:\KrReleases\V6.0.0"/>
	<property name="temp" value="z:\temp"/>
	<property name="joomlaID" value="j532"/>
	<property name="filename" value="pkg_${itsShortID}_${joomlaID}_${itsVersion}.zip"/>
	<property name="temp.dir" value="${temp}\pkg_${itsShortID}"/>
	<property name="packages.dir" value="${temp}\pkg_${itsShortID}\packages"/>
	<property name="delivery.dir" value="${releases}\${itsShortID}_${itsVersion}"/>
	<property name="delivery.file" value="${delivery.dir}/../${filename}"/>

	<!--- tokenized list of name separated by, if none apply leave empty-->
	<property name="itsModules"
	          value="mod_knowres_headermenu,mod_knowres_autosearch,mod_knowres_carousel,mod_knowres_destination,mod_knowres_featured,mod_knowres_imagegrid,mod_knowres_mailchimp,mod_knowres_properties,mod_knowres_regions,mod_knowres_search,mod_knowres_searchbymap,mod_knowres_slideshow,mod_knowres_spotlight"/>
	<property name="itsSystemPlugins" value="knowresredirect"/>
	<property name="itsOsmapPlugins" value="knowres"/>
	<property name="itsForsefPlugins" value="knowres"/>
	<property name="itsLanguages" value="en-GB"/>
	<property name="$searchForThis" value="false"/>

	<target name="create.package" description="build the package">
		<echo message="Running build.xml. Assembling"/>
		<mkdir dir="${temp}"/>
		<mkdir dir="${temp.dir}"/>
		<mkdir dir="${packages.dir}"/>
		<mkdir dir="${releases}"/>
		<phingcall target="copy.code"/>
		<phingcall target="zip.code"/>

		<zip destfile="${delivery.file}">
			<fileset dir="${temp.dir}">
				<include name="pkg_${itsShortID}.xml"/>
				<include name="pkg_knowres_installation.php"/>
				<include name="packages/*.zip"/>
			</fileset>
		</zip>

		<delete dir="${temp}"/>
	</target>

	<target name="copy.code" description="copy code" depends="clean">
		<!-- Copy code -->
		<echo message="copy folders"/>
		<!-- Copy package manifest xml and install script -->
		<copy file="pkg_knowres.xml" todir="${temp.dir}" overwrite="true"/>
		<copy file="pkg_knowres_installation.php" todir="${temp.dir}" overwrite="true"/>
		<!--		<copy file="knowres.xml" todir="${temp.dir}" overwrite="true"/>-->
		<!-- Copy component manifest xml -->
		<!--		<copy file="${project.basedir}/com_${itsShortID}/admin/knowres.xml" todir="${project.basedir}/com_${itsShortID}" overwrite="true"/>-->
		<!-- Copy component installation script -->
		<!--		<copy file="${project.basedir}/com_${itsShortID}/admin/com_script.php" todir="${project.basedir}/com_${itsShortID}" overwrite="true"/>-->
	</target>

	<target name="zip.code" description="zip code">
		<!-- Zip files in code -->
		<echo message="zipping folders ${project.basedir}"/>
		<echo message="zipping to ${packages.dir}/packages"/>
		<copy file="src/admin/knowres.xml" tofile="src/knowres.xml" />

		<zip destfile="${packages.dir}/com_${itsShortID}.zip">
			<fileset dir="${project.basedir}/src">
				<include name="admin/**" />
				<include name="admin/knowres.xml"/>
				<include name="site/**" />
				<include name="media/**" />
				<include name="knowres.xml" />
				<!--				<include name="media/com_knowres/**" />-->
				<!--				<include name="media/com_knowres/vendor/**" />-->
				<!--				<include name="media/com_knowres/vendor/tecnickcom/**" />-->
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/examples/**" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/ae_fonts_2.0/**" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/dejavu-fonts-ttf-2.33/**" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/dejavu-fonts-ttf-2.34/**" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/freefont-20100919/**" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/freefont-20120503/**" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*aeal*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*aef*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*cid*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*courier*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*free*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*hysm*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*koz*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*msung*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*symbol*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*times*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*dingbats*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*stsong*" />
				<exclude name="media/com_knowres/vendor/tecnickcom/tcpdf/fonts/*uni2*" />
<!--				<exclude name="api" />-->
				<exclude name="libraries" />
				<exclude name="modules" />
				<exclude name="plugins" />
			</fileset>
		</zip>

		<zip basedir="${project.basedir}/src/libraries" destfile="${packages.dir}/lib_highlandvision_kr.zip"/>

		<foreach list="${itsModules}" param="moduleID" target="doModule">
			<property name="type" value="module"/>
		</foreach>
		<foreach list="${itsSystemPlugins}" param="pluginID" target="doPlugin">
			<property name="type" value="system"/>
		</foreach>
		<foreach list="${itsForsefPlugins}" param="pluginID" target="doPlugin">
			<property name="type" value="forsef"/>
		</foreach>
		<foreach list="${itsOsmapPlugins}" param="pluginID" target="doPlugin">
			<property name="type" value="osmap"/>
		</foreach>

		<delete file="src/knowres.xml"/>
	</target>

	<target name="clean">
		<echo message="Running Cleaning"/>
		<delete file="${delivery.file}" quiet="true"/>
	</target>

	<target name="doPlugin">
		<zip destfile="${packages.dir}/plg_${type}_${pluginID}.zip" basedir="${project.basedir}/src/plugins/plg_${type}_${pluginID}"/>
	</target>

	<target name="doModule">
		<echo message="packaging ${moduleID}"/>
		<zip destfile="${packages.dir}/${moduleID}.zip" basedir="${project.basedir}/src/modules/${moduleID}"/>
	</target>
</project>