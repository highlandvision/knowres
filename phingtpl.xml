<?xml version="1.0" encoding="UTF-8"?>
<project name="KRThemes" basedir="." default="create.template">
	<property name="itsVersion" value="5.2.0"/>
	<property name="itsShortID" value="krtheme"/>
	<property name="releases" value="Z:\KrReleases\V5.2.0"/>
	<property name="temp" value="z:\temp"/>
	<property name="joomlaID" value="j532"/>
	<property name="filename" value="tpl_${itsShortID}_${joomlaID}_${itsVersion}.zip"/>
	<property name="temp.dir" value="${temp}\tpl_${itsShortID}"/>
	<property name="delivery.dir" value="${releases}\${itsShortID}_${itsVersion}"/>
	<property name="delivery.file" value="${delivery.dir}/../${filename}"/>
	<property name="templatespath" value="templates/" />
	<property name="template" value="${templatespath}\krtheme" />

	<target name="create.template" description="create template package">
		<echo>Creating archive...</echo>
		<echo>Template path: ${templatespath}</echo>
		<echo>Template: ${template}</echo>
		<echo>Delivery Directory: ${delivery.dir}</echo>
		<echo>Delivery File ${delivery.file}</echo>
		<echo>Base Dir ${project.basedir}</echo>

		<zip destfile="${delivery.file}">
			<fileset dir="${template}">
				<exclude name=".idea/**" />
				<exclude name=".gitignore" />
				<include name="css/**" />
				<include name="fonts/**" />
				<include name="html/**" />
				<include name="images/**" />
				<include name="language/**" />
				<include name="scss/**" />
				<include name="component.php" />
				<include name="error.php" />
				<include name="favicon.ico" />
				<include name="index.php" />
				<include name="joomla.asset.json" />
		        <include name="KrthemeInstallerScript.php" />
				<include name="templateDetails.xml" />
			</fileset>
		</zip>
		<delete dir="${temp}"/>
	</target>
</project>