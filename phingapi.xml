<?xml version="1.0" encoding="UTF-8"?>
<project name="KRApis" basedir="." default="create.api">
	<input propertyName="itsShortID" message="id message" description="api name" validArgs="helpscout,pricelabs,ru,xero">
		Select API
	</input>
	<input propertyName="itsVersion" message="version message" description="api version" defaultValue="5.2.0"
		   promptChar="?">
		Version
	</input>

	<property name="releases" value="Z:\KrReleases\V5.2.0"/>
	<property name="temp" value="z:\temp"/>
	<property name="joomlaID" value="j532"/>
	<property name="filename" value="lib_highlandvision_${itsShortID}_${joomlaID}_${itsVersion}.zip"/>
	<property name="temp.dir" value="${temp}\lib_${itsShortID}"/>
	<property name="delivery.dir" value="${releases}"/>
	<property name="delivery.file" value="${delivery.dir}\${filename}"/>
	<mkdir dir="${temp}"/>

	<target name="create.api" description="build the api library">
		<echo>Creating archive...</echo>
		<echo>Api: ${itsShortID}</echo>
		<echo>Basedir: ${project.basedir}</echo>
		<echo>Filename: ${filename}</echo>

		<zip destfile="${delivery.file}">
			<fileset dir="${project.basedir}/api">
				<exclude name="${itsShortID}/.idea/**" />
				<include name="${itsShortID}/**" />
			</fileset>
		</zip>
		<delete dir="${temp}"/>
	</target>
</project>